# Azure OpenAI: cheia se păstrează exclusiv pe server, niciodată în VITE_*.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_MODEL=gpt-4.1-mini
AZURE_OPENAI_API_KEY=

# SMTP pentru formularul de contact. Destinatarul nu este inventat; completează adresa generică reală.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Google Analytics 4; urmărirea pornește doar după consimțământul utilizatorului.
VITE_GA_MEASUREMENT_ID=
